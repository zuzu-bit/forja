rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Profiluri: oricine e conectat poate citi (nume, stare, poziție — doar ce publici),
    // dar doar tu îți poți scrie documentul.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid);
      allow delete: if false;

      // Jurnalele private (mese, somn, activități): DOAR proprietarul.
      // Compania le vede din consola Firebase; prietenii nu le văd niciodată.
      match /{sub}/{docId} {
        allow read, write: if isMe(uid);
      }
    }

    // Coduri de invitație: citire pentru oricine conectat, scriere doar pentru propriul cod.
    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Prietenii: doar membrii pot crea/șterge relația lor.
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if false;
    }

    // Energie (kudos): trimiți doar tu, citește doar destinatarul; un fulger pe zi (id compus).
    match /energy/{id} {
      allow read: if signedIn() && resource.data.to == request.auth.uid;
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update, delete: if false;
    }

    // Locuri recomandate prietenilor (v4.0): le vede proprietarul și cei din visibleTo.
    match /places/{placeId} {
      allow read: if signedIn()
                  && (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.visibleTo);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
                    && request.resource.data.name is string && request.resource.data.name.size() <= 80
                    && request.resource.data.note is string && request.resource.data.note.size() <= 300
                    && request.resource.data.visibleTo is list && request.resource.data.visibleTo.size() <= 100
                    && (!('visits' in request.resource.data)
                        || (request.resource.data.visits is int && request.resource.data.visits >= 1));
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Familia (v4.0): poziția ta o văd — și în modul fantomă — DOAR cei din `allowed`.
    match /familyLoc/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid in resource.data.allowed);
      allow create, update: if isMe(uid)
                            && request.resource.data.allowed is list && request.resource.data.allowed.size() <= 50;
      allow delete: if isMe(uid);
    }
  }
}
