<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:label="FORJA"
        android:networkSecurityConfig="@xml/research_network_security"
        tools:replace="android:label">
        <activity android:name=".feature.research.ResearchExportActivity"
            android:exported="false" android:label="Datele mele" />
        <activity android:name=".feature.research.HealthExportActivity" android:exported="false" />
