<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Forja" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface0</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <!-- „Ascultă acum” fără să acopere aplicația din față (VoiceListenActivity). -->
    <style name="Theme.Forja.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
