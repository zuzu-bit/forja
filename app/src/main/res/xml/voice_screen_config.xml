<?xml version="1.0" encoding="utf-8"?>
<!-- „FORJA · Comenzi pe ecran": asistentul vocal vede ecranul aplicației din față și lucrează în ea
     (citește, apasă, scrie, caută, derulează) — DOAR când o comandă vocală o cere. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/voice_screen_desc"
    android:isAccessibilityTool="true"
    android:notificationTimeout="100"
    android:settingsActivity="com.forja.app.MainActivity" />
