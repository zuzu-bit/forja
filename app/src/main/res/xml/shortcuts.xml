<?xml version="1.0" encoding="utf-8"?>
<!-- Apăsare lungă pe iconița FORJA → „Hei FORJA" ascultă imediat. Se poate trage și pe ecranul principal.
     targetPackage = applicationId din app/build.gradle.kts (com.forja.app.research), NU namespace-ul. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="voice_listen"
        android:enabled="true"
        android:icon="@drawable/ic_voice_mic"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="com.forja.app.action.VOICE_LISTEN"
            android:targetPackage="com.forja.app.research"
            android:targetClass="com.forja.app.MainActivity" />
    </shortcut>
</shortcuts>
